<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Car Comfort E2E Regression Suite" parallel="false" thread-count="1">
    <parameter name="deviceUdid" value="${ANDROID_DEVICE_UDID}"/>

    <test name="Cross-Role E2E Regression" preserve-order="true">
        <groups>
            <run>
                <include name="e2e"/>
                <exclude name="gated,one-time,verification,payment-setup,account-bootstrap,destructive"/>
            </run>
        </groups>
        <packages>
            <package name="com.carcomfort.tests.e2e"/>
            <package name="com.carcomfort.tests.android.e2e"/>
        </packages>
    </test>
</suite>
