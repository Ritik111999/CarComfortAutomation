<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Car Comfort Customer Regression Suite" parallel="false" thread-count="1">
    <parameter name="deviceUdid" value="${ANDROID_DEVICE_UDID}"/>

    <test name="Android Customer Regression" preserve-order="true">
        <groups>
            <run>
                <include name="regression"/>
                <include name="android"/>
                <include name="customer"/>
                <exclude name="gated,one-time,verification,payment-setup,account-bootstrap,destructive"/>
            </run>
        </groups>
        <packages>
            <package name="com.carcomfort.tests.android.customer"/>
        </packages>
    </test>

    <test name="Customer PWA Regression" preserve-order="true">
        <groups>
            <run>
                <include name="regression"/>
                <include name="pwa"/>
                <include name="customer"/>
                <exclude name="gated,one-time,verification,payment-setup,account-bootstrap,destructive"/>
            </run>
        </groups>
        <packages>
            <package name="com.carcomfort.tests.web.customer"/>
        </packages>
    </test>
</suite>
