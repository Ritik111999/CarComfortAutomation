<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Car Comfort Admin Regression Suite" parallel="false" thread-count="1">
    <test name="Admin PWA Regression" preserve-order="true">
        <groups>
            <run>
                <include name="regression"/>
                <include name="pwa"/>
                <include name="admin"/>
                <exclude name="gated,one-time,verification,payment-setup,account-bootstrap,destructive"/>
            </run>
        </groups>
        <packages>
            <package name="com.carcomfort.tests.web.admin"/>
        </packages>
    </test>

    <test name="Android Admin Regression" preserve-order="true">
        <groups>
            <run>
                <include name="regression"/>
                <include name="android"/>
                <include name="admin"/>
                <exclude name="gated,one-time,verification,payment-setup,account-bootstrap,destructive"/>
            </run>
        </groups>
        <packages>
            <package name="com.carcomfort.tests.android.admin"/>
        </packages>
    </test>
</suite>
