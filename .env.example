# Car Comfort Automation - Environment Configuration
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control

# ============================================================
# EXECUTION IDENTITY
# ============================================================
EXECUTION_ID=
AUTOMATION_OWNER_ID=antigravity
BUILD_NUMBER=
BUILD_TIMESTAMP=

# ============================================================
# ANDROID PHYSICAL DEVICE
# ============================================================
ANDROID_DEVICE_UDID=
ANDROID_DEVICE_NAME=
ANDROID_DEVICE_OS_VERSION=
ANDROID_APP_PACKAGE=
ANDROID_APP_ACTIVITY=
ANDROID_CONNECTION_TYPE=USB

# ============================================================
# IOS PHYSICAL DEVICE (Future)
# ============================================================
IOS_DEVICE_UDID=
IOS_DEVICE_NAME=
IOS_DEVICE_OS_VERSION=
IOS_APP_BUNDLE_ID=
IOS_XCODE_ORG_ID=
IOS_XCODE_SIGNING_ID=
IOS_WDA_URL=

# ============================================================
# PWA URLS
# ============================================================
CUSTOMER_PWA_URL=https://customer.carcomfort.example.com
ADMIN_PWA_URL=https://admin.carcomfort.example.com

# ============================================================
# SELENIUM GRID (Optional)
# ============================================================
SELENIUM_REMOTE_URL=

# ============================================================
# APPIUM MCP (stdio sidecar, see .agents/mcp_config.json)
# Requires: npm i -g appium-mcp @appium/mcp-documentation
# ============================================================
APPIUM_MCP_DOCS_ENABLED=true
APPIUM_MCP_NO_UI=true
APPIUM_MCP_EVIDENCE=true
APPIUM_MCP_VISION_ENABLED=false

# ============================================================
# TEST ACCOUNTS (Use environment-specific test accounts only)
# ============================================================
# Customer test accounts
CUSTOMER_TEST_EMAIL=
CUSTOMER_TEST_PASSWORD=
CUSTOMER_TEST_PHONE=

# Provider test accounts
PROVIDER_TEST_EMAIL=
PROVIDER_TEST_PASSWORD=
PROVIDER_TEST_PHONE=

# Admin test accounts
ADMIN_TEST_EMAIL=
ADMIN_TEST_PASSWORD=

# ============================================================
# PAYMENT SANDBOX (Stripe test keys only)
# ============================================================
STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_SECRET_KEY_TEST=

# ============================================================
# GATED TEST AUTHORIZATION
# ============================================================
RUN_GATED_TESTS=false
GATED_CASE=